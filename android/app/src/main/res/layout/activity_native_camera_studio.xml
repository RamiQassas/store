<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#030712"
    android:layoutDirection="rtl">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/studio_topbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:background="#0B1120"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/btn_studio_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="إغلاق"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#F8FAFC" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="استوديو تصوير رقميات ⚡"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/studio_active_product_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="أدخل كود المنتج للبدء"
                android:textColor="#22D3EE"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_change_code"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_chip_unselected"
            android:paddingHorizontal="12dp"
            android:text="تغيير الكود"
            android:textColor="#FBBF24"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Camera Viewfinder Stage -->
    <RelativeLayout
        android:id="@+id/camera_stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/studio_topbar"
        android:visibility="gone">

        <androidx.camera.view.PreviewView
            android:id="@+id/camera_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Square Framing Guide -->
        <View
            android:id="@+id/framing_box"
            android:layout_width="270dp"
            android:layout_height="270dp"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_input_dark"
            android:alpha="0.32" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/framing_box"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="10dp"
            android:background="#B0030712"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:text="ضع المنتج في المنتصف • سيتم عزل الخلفية تلقائياً"
            android:textColor="#22D3EE"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Studio Background Style Selector -->
        <LinearLayout
            android:id="@+id/bg_style_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="12dp"
            android:background="#CC030712"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/opt_bg_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_selected"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="خلفية بيضاء احترافية"
                android:textColor="#030712"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/opt_bg_dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="خلفية داكنة فاخرة"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bottom Shutter Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_alignParentBottom="true"
            android:background="#CC030712"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp">

            <Button
                android:id="@+id/btn_studio_gallery"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_unselected"
                android:text="المعرض"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_studio_capture"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="16dp"
                android:layout_weight="1.6"
                android:background="@drawable/bg_button_cyan"
                android:text="📸 التقط وعيّن فوراً"
                android:textColor="#030712"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_studio_flash"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_unselected"
                android:text="فلاش: إيقاف"
                android:textColor="#FBBF24"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Processing Overlay -->
    <LinearLayout
        android:id="@+id/processing_stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/studio_topbar"
        android:background="#E6030712"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:indeterminateTint="#22D3EE" />

        <TextView
            android:id="@+id/processing_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="جاري عزل الخلفية وتجهيز عرض رقميات الاحترافي..."
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Final Result Stage -->
    <LinearLayout
        android:id="@+id/result_stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/studio_topbar"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/result_status_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓ تم عزل الخلفية وتعيين الصورة بنجاح!"
            android:textColor="#34D399"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/result_preview_image"
            android:layout_width="290dp"
            android:layout_height="290dp"
            android:layout_marginTop="16dp"
            android:background="#FFFFFF"
            android:scaleType="fitCenter"
            android:contentDescription="نتيجة الاستوديو" />

        <Button
            android:id="@+id/btn_next_product"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_button_cyan"
            android:text="تصوير منتج آخر (إدخال كود جديد)"
            android:textColor="#030712"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_retake_current"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_chip_unselected"
            android:text="إعادة تصوير نفس المنتج"
            android:textColor="#E2E8F0"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_done_studio"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_gold"
            android:text="تم والعودة"
            android:textColor="#030712"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Step 1: Enter Product Code Overlay -->
    <LinearLayout
        android:id="@+id/code_entry_stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/studio_topbar"
        android:background="#030712"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📦 أدخل كود المنتج"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="أدخل كود المنتج (SKU أو رقم المنتج أو الاسم) ليتم فتح الكاميرا مباشرة وتعيين الصورة بعزل خلفية احترافي وشعار رقميات."
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/input_product_code"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input_dark"
                android:hint="مثال: ANK-20W أو رقم المنتج"
                android:imeOptions="actionGo"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/code_error_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#F87171"
                android:textSize="12sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/code_lookup_progress"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:indeterminateTint="#22D3EE"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_lookup_code"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_cyan"
                android:text="فتح الكاميرا للمنتج 📷"
                android:textColor="#030712"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
