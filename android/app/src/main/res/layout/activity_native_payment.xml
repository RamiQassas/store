<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#030712"
    android:layoutDirection="rtl">

    <!-- Luxury Native Top Bar -->
    <LinearLayout
        android:id="@+id/pay_topbar"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_alignParentTop="true"
        android:background="#0B1120"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/btn_pay_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="رجوع"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="#F8FAFC" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المحفظة وبوابات الدفع ⚡"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pay_rate_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مزامنة حية مع حسابك في رقميات"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_pay_refresh"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_chip_unselected"
            android:paddingHorizontal="10dp"
            android:text="🔄 تحديث"
            android:textColor="#22D3EE"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/pay_topbar"
        android:clipToPadding="false"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Unauthenticated Prompt Banner -->
            <LinearLayout
                android:id="@+id/pay_login_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_gateway_selected"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="سجّل دخولك لعرض رصيدك الحقيقي"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="مزامنة فورية للرصيد بالدولار والسوري وتفعيل الشحن المباشر"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_pay_login_now"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_button_gold"
                    android:paddingHorizontal="14dp"
                    android:text="تسجيل الدخول ⚡"
                    android:textColor="#030712"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Luxury Wallet Balance Hero Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_wallet_hero"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/pay_user_greeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="رصيد محفظتك المتاح"
                            android:textColor="#CBD5E1"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/pay_wallet_balance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="$0.00"
                            android:textColor="#FBBF24"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/pay_wallet_secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="≈ 0 ل.س"
                            android:textColor="#22D3EE"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Instant Balance Currency Switcher -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/opt_curr_usd"
                            android:layout_width="90dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_chip_selected"
                            android:gravity="center"
                            android:text="USD $"
                            android:textColor="#030712"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/opt_curr_syp"
                            android:layout_width="90dp"
                            android:layout_height="32dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_chip_unselected"
                            android:gravity="center"
                            android:text="ل.س SYP"
                            android:textColor="#E2E8F0"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Pending/Held Breakdown + Redeem Recharge Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/pay_wallet_breakdown"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="جاهز للشراء الفوري 24/7"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_redeem_card"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingHorizontal="12dp"
                        android:text="🎟️ شحن كرت رقميات"
                        android:textColor="#FBBF24"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Dynamic Payment Gateways Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="اختر بوابة الدفع أو وسيلة الشحن"
                    android:textColor="#F8FAFC"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pay_gateways_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#22D3EE"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Populated dynamically with all live site gateways + logos via Glide -->
            <LinearLayout
                android:id="@+id/pay_gateways_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <!-- Manual Payment Instructions & Reference Input (Shown only for manual methods) -->
            <LinearLayout
                android:id="@+id/pay_manual_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/pay_manual_instructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.3"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/pay_manual_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <EditText
                    android:id="@+id/pay_manual_ref_input"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input_dark"
                    android:hint="رقم عملية التحويل أو اسم المرسل"
                    android:paddingHorizontal="12dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Amount Input & Limits -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pay_amount_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="المبلغ المطلوب شحنه ($ USD)"
                    android:textColor="#F8FAFC"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pay_limits_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/pay_amount_input"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_dark"
                android:hint="أدخل المبلغ (مثال: 25)"
                android:inputType="numberDecimal"
                android:paddingHorizontal="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pay_conversion_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#22D3EE"
                android:textSize="11.5sp"
                android:visibility="gone" />

            <!-- Smart Currency-Aware Quick Amounts -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_amt_5"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_unselected"
                    android:text="$5"
                    android:textAllCaps="false"
                    android:textColor="#F8FAFC"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_amt_10"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_unselected"
                    android:text="$10"
                    android:textAllCaps="false"
                    android:textColor="#F8FAFC"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_amt_25"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_unselected"
                    android:text="$25"
                    android:textAllCaps="false"
                    android:textColor="#F8FAFC"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_amt_50"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_unselected"
                    android:text="$50"
                    android:textAllCaps="false"
                    android:textColor="#F8FAFC"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/pay_status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_dark"
                android:padding="12dp"
                android:textColor="#22D3EE"
                android:textSize="12sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/pay_progress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:indeterminateTint="#22D3EE"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_pay_submit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_button_gold"
                android:text="متابعة الشحن الفوري عبر البوابة ⚡"
                android:textAllCaps="false"
                android:textColor="#030712"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_pay_verify"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_cyan"
                android:text="تحقق من اكتمال الدفع وتحديث الرصيد 🔄"
                android:textAllCaps="false"
                android:textColor="#030712"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Recent Wallet Transactions History -->
            <TextView
                android:id="@+id/pay_recent_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="آخر عمليات الشحن والإيداع"
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/pay_recent_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
