<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a0a0f">

    <!-- Connectivity Status Banner (Animated Slide In/Out) -->
    <LinearLayout
        android:id="@+id/connectivity_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#b45309"
        android:paddingVertical="7dp"
        android:paddingHorizontal="14dp"
        android:gravity="center"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/banner_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️ أنت تتصفح بدون إنترنت • يتم عرض البيانات المخزنة محلياً"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/page_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:layout_below="@id/connectivity_banner"
        android:indeterminate="false"
        android:max="100"
        android:progressDrawable="@android:color/holo_blue_bright"
        android:elevation="10dp"
        android:visibility="gone" />

    <!-- Real Native Android Storefront Container (Home & Products) -->
    <LinearLayout
        android:id="@+id/native_store_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/page_progress"
        android:layout_above="@id/native_bottom_navigation"
        android:background="#030712"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Native Luxury App Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#0B1120"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="رقميات" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="رقميات | Raqamiyat"
                    android:textColor="#D4A853"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/native_store_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="متجر المنتجات والخدمات الرقمية"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_admin_quick_studio"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_button_cyan"
                android:paddingHorizontal="10dp"
                android:text="📷 استوديو الإدارة"
                android:textColor="#030712"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_native_pay"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_button_gold"
                android:paddingHorizontal="10dp"
                android:text="💳 شحن"
                android:textColor="#030712"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_native_notif"
                android:layout_width="38dp"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_unselected"
                android:text="🔔"
                android:textColor="#F8FAFC"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_native_cart"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_chip_unselected"
                android:paddingHorizontal="10dp"
                android:text="🛒 السلة"
                android:textColor="#F8FAFC"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Native Search Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#060B16"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="8dp">

            <EditText
                android:id="@+id/native_search_input"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_dark"
                android:hint="🔍 ابحث عن منتج، تصنيف، أو كود المنتج..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="13sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/native_categories_rv"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:clipToPadding="false" />
        </LinearLayout>

        <!-- Native Products Grid with Pull-to-Refresh -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/native_catalog_swipe"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/native_products_rv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:padding="6dp" />

                <TextView
                    android:id="@+id/native_empty_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="لا توجد منتجات مطابقة لبحثك"
                    android:textColor="#64748B"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <!-- Main Web Content Area (Only for Wallet, Orders, Account & Admin Portal) -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/page_progress"
        android:layout_above="@id/native_bottom_navigation"
        android:visibility="gone">

        <WebView
            android:id="@+id/main_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0a0a0f" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Native Mobile Ergonomic Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/native_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_alignParentBottom="true"
        android:background="#030712"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingVertical="4dp"
        android:elevation="14dp">

        <!-- 1. الرئيسية -->
        <LinearLayout
            android:id="@+id/nav_item_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nav_icon_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏠"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/nav_text_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الرئيسية"
                android:textColor="#D4A853"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2. الخدمات -->
        <LinearLayout
            android:id="@+id/nav_item_catalog"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nav_icon_catalog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/nav_text_catalog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الخدمات"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 3. المحفظة والرصيد -->
        <LinearLayout
            android:id="@+id/nav_item_wallet"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nav_icon_wallet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💳"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/nav_text_wallet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المحفظة"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 4. طلباتي -->
        <LinearLayout
            android:id="@+id/nav_item_orders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nav_icon_orders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📦"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/nav_text_orders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="طلباتي"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 5. حسابي -->
        <LinearLayout
            android:id="@+id/nav_item_account"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nav_icon_account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/nav_text_account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="حسابي"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Custom Native Offline Fallback View (Shown only on catastrophic failure) -->
    <LinearLayout
        android:id="@+id/native_error_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0a0a0f"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        android:elevation="8dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@mipmap/ic_launcher"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تعذر الاتصال بالخادم"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="يبدو أنك غير متصل بالإنترنت حالياً. يمكنك تصفح المنتجات والخدمات المحفوظة محلياً، أو إعادة المحاولة فور توفر الشبكة."
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_retry_connection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="إعادة المحاولة 🔄"
                android:textColor="#000000"
                android:backgroundTint="#06B6D4"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="20dp"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/btn_browse_cached"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الكتالوج المحفوظ 📦"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1E293B"
                android:textSize="12sp"
                android:paddingHorizontal="16dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Luxury Native Splash Screen Overlay -->
    <RelativeLayout
        android:id="@+id/splash_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0a0a0f"
        android:elevation="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:src="@mipmap/ic_launcher"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="رقميات | Raqamiyat"
                android:textColor="#D4A853"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="بوابتك المتكاملة للخدمات والمنتجات"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:layout_marginBottom="24dp" />

            <ProgressBar
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:indeterminateTint="#06B6D4" />
        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>
