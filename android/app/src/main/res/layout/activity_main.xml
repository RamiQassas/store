<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#030712">

    <!-- Connectivity Status Banner -->
    <LinearLayout
        android:id="@+id/connectivity_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#b45309"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="7dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/banner_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️ أنت تتصفح بدون إنترنت • يتم عرض البيانات المخزنة محلياً"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/page_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:layout_below="@id/connectivity_banner"
        android:elevation="10dp"
        android:indeterminate="false"
        android:max="100"
        android:progressDrawable="@android:color/holo_blue_bright"
        android:visibility="gone" />

    <!-- ══════════════════════════════════════════════════════════════ -->
    <!-- 1. NATIVE STOREFRONT CONTAINER (الرئيسية والخدمات)             -->
    <!-- ══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/native_store_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/native_bottom_navigation"
        android:layout_below="@id/page_progress"
        android:background="#030712"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Native Luxury App Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#0B1120"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="رقميات"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="رقميات | Raqamiyat"
                    android:textColor="#D4A853"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/native_store_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="شحن فوري • بطاقات وخدمات رقمية"
                    android:textColor="#94A3B8"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_admin_quick_studio"
                android:layout_width="36dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_button_cyan"
                android:padding="0dp"
                android:text="📷"
                android:textColor="#030712"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btn_native_currency"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_chip_selected"
                android:gravity="center"
                android:paddingHorizontal="9dp"
                android:text="USD $"
                android:textColor="#030712"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_native_pay"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_button_gold"
                android:paddingHorizontal="9dp"
                android:text="💳 شحن"
                android:textAllCaps="false"
                android:textColor="#030712"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_native_notif"
                android:layout_width="34dp"
                android:layout_height="32dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_chip_unselected"
                android:padding="0dp"
                android:text="🔔"
                android:textColor="#F8FAFC"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_native_cart"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_chip_unselected"
                android:paddingHorizontal="8dp"
                android:text="🛒 0"
                android:textAllCaps="false"
                android:textColor="#22D3EE"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Luxury Hero Wallet & Official Gateways Strip -->
        <LinearLayout
            android:id="@+id/hero_wallet_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_wallet_hero"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/hero_wallet_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="رصيد محفظتك المتاح ⚡"
                    android:textColor="#CBD5E1"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/hero_wallet_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="سجّل دخولك لمزامنة الرصيد"
                    android:textColor="#FBBF24"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Official Payment Gateways Logos Strip -->
            <LinearLayout
                android:id="@+id/hero_gateways_strip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- Native Search Bar & Category Chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#030712"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">

            <EditText
                android:id="@+id/native_search_input"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_input_dark"
                android:hint="🔍 ابحث عن بطاقة، لعبة، اشتراك، أو كود..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="12.5sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/native_categories_rv"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:clipToPadding="false" />
        </LinearLayout>

        <!-- Native Products Grid with Pull-to-Refresh -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/native_catalog_swipe"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/native_products_rv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:padding="5dp" />

                <TextView
                    android:id="@+id/native_empty_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="لا توجد منتجات مطابقة لبحثك"
                    android:textColor="#64748B"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════════════ -->
    <!-- 2. NATIVE ORDERS CONTAINER (طلباتي - 100% Native)              -->
    <!-- ══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/native_orders_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/native_bottom_navigation"
        android:layout_below="@id/page_progress"
        android:background="#030712"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#0B1120"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📦 طلباتي وأكواد التسليم"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_orders_refresh"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_chip_unselected"
                android:paddingHorizontal="12dp"
                android:text="🔄 تحديث"
                android:textAllCaps="false"
                android:textColor="#22D3EE"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/native_orders_swipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="12dp">

                <LinearLayout
                    android:id="@+id/native_orders_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════════════ -->
    <!-- 3. NATIVE ACCOUNT CONTAINER (حسابي - 100% Native)              -->
    <!-- ══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/native_account_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/native_bottom_navigation"
        android:layout_below="@id/page_progress"
        android:background="#030712"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#0B1120"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="👤 حسابي وإعدادات التطبيق"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="14dp">

            <LinearLayout
                android:id="@+id/native_account_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════════════ -->
    <!-- 4. WEBVIEW PORTAL (Only for External Gateways / Admin Tools)  -->
    <!-- ══════════════════════════════════════════════════════════════ -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/native_bottom_navigation"
        android:layout_below="@id/page_progress"
        android:visibility="gone">

        <WebView
            android:id="@+id/main_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0a0a0f" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Native Mobile Ergonomic Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/native_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_alignParentBottom="true"
        android:background="#0B1120"
        android:elevation="16dp"
        android:gravity="center"
        android:layoutDirection="rtl"
        android:orientation="horizontal"
        android:paddingVertical="4dp">

        <!-- 1. الرئيسية -->
        <LinearLayout
            android:id="@+id/nav_item_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nav_icon_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏠"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/nav_text_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الرئيسية"
                android:textColor="#D4A853"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2. المنتجات -->
        <LinearLayout
            android:id="@+id/nav_item_catalog"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nav_icon_catalog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/nav_text_catalog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المنتجات"
                android:textColor="#94A3B8"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- 3. المحفظة -->
        <LinearLayout
            android:id="@+id/nav_item_wallet"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nav_icon_wallet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💳"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/nav_text_wallet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المحفظة"
                android:textColor="#94A3B8"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- 4. طلباتي -->
        <LinearLayout
            android:id="@+id/nav_item_orders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nav_icon_orders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📦"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/nav_text_orders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="طلباتي"
                android:textColor="#94A3B8"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- 5. حسابي -->
        <LinearLayout
            android:id="@+id/nav_item_account"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nav_icon_account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/nav_text_account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="حسابي"
                android:textColor="#94A3B8"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Custom Native Offline Fallback View -->
    <LinearLayout
        android:id="@+id/native_error_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0a0a0f"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="16dp"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="تعذر الاتصال بالخادم"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="يبدو أنك غير متصل بالإنترنت حالياً. يمكنك تصفح المنتجات والخدمات المحفوظة محلياً، أو إعادة المحاولة فور توفر الشبكة."
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_retry_connection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:backgroundTint="#06B6D4"
                android:paddingHorizontal="20dp"
                android:text="إعادة المحاولة 🔄"
                android:textColor="#000000"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_browse_cached"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#1E293B"
                android:paddingHorizontal="16dp"
                android:text="الكتالوج المحفوظ 📦"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Luxury Native Splash Screen Overlay -->
    <RelativeLayout
        android:id="@+id/splash_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#030712"
        android:elevation="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:layout_marginBottom="14dp"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:letterSpacing="0.04"
                android:text="رقميات | Raqamiyat"
                android:textColor="#D4A853"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="متجرك العالمي للبطاقات والخدمات الرقمية"
                android:textColor="#64748B"
                android:textSize="11.5sp" />

            <ProgressBar
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:indeterminateTint="#06B6D4" />
        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>
